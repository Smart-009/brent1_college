# Éclat Institute - MetaTrader 5 and Trading Bot Configuration
# Copy this file to .env and fill in your credentials

# MetaTrader 5 Account Credentials
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_investor_or_master_password
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Trading Bot Parameters
BOT_SYMBOL=EURUSD
BOT_TIMEFRAME=M15
BOT_STRATEGY=ema_crossover  # Options: ema_crossover, rsi_mean_reversion
BOT_MAGIC_NUMBER=260901

# Risk Management and Prop Firm Compliance
RISK_PER_TRADE_PERCENT=1.0  # 1.0% equity risk per trade
MAX_DAILY_DRAWDOWN_PERCENT=4.0  # Max daily loss before hard kill-switch
MAX_OPEN_POSITIONS=2
MAX_SPREAD_PIPS=2.5
RISK_TO_REWARD_RATIO=2.0  # 1:2 Risk to Reward minimum

# Telegram Real-time Notifications (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
