# =============================================================================
# QUANT ENGINE — ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual credentials in .env
#   3. NEVER commit .env to git (it is already in .gitignore)
#   4. Leave unused brokers empty — the bot skips disabled markets.
# =============================================================================

# ── Crypto: Binance ──────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Crypto: Bybit ────────────────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Stocks (US): Alpaca ──────────────────────────────────────────────────────
# Get keys from: https://app.alpaca.markets/paper-trading (paper is free)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── Stocks (Global): Interactive Brokers ────────────────────────────────────
# IBKR connects via TWS desktop app — no separate API key needed.
# Just ensure TWS is running and API connections are enabled on port 7497.

# ── Forex: MetaTrader 5 ──────────────────────────────────────────────────────
# Use your demo account credentials from any MT5-compatible broker.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── Forex: OANDA (alternative to MT5) ───────────────────────────────────────
# Get practice API key from: https://www.oanda.com/us-en/trading/api/
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# ── Telegram Alerts ──────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get the token.
# Get your chat_id by messaging @userinfobot on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── News Feeds (Optional) ────────────────────────────────────────────────────
FINNHUB_API_KEY=
